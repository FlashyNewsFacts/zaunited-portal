{
  "name": "zaunited-portal",
  "version": "0.1.0",
  "private": true,
  "description": "The ZAUNITED Kingdom Portal: watch the Kingdom of Zaun grow.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate:data && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate:data": "node scripts/validate-kingdom.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "verify": "npm run validate:data && npm test && npm run check && astro build && npm run test:build",
    "test:build": "node --test \"tests/postbuild/*.test.ts\""
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
