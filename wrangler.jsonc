// Cloudflare Workers configuration for the ZAUNITED Kingdom Portal.
// Static site only: no server code, no bindings and no secrets.
// Nothing deploys until Cloudflare is connected to this repository and the
// owner approves the launch (see docs/DEPLOYMENT.md).
{
  // Public address: https://<name>.<account-subdomain>.workers.dev
  // e.g. https://kingdom.zaunited.workers.dev. Must match the Worker's name in Cloudflare.
  "name": "kingdom",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist"
  },
  // The free workers.dev production address stays public (no login).
  "workers_dev": true,
  // No public preview links for branches or versions.
  "preview_urls": false
}
