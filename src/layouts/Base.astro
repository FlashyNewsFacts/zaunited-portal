---
import '../styles/global.css';
import { SITE } from '../lib/site.ts';

interface Props {
  title?: string;
  description?: string;
  /** For pages that shouldn't appear in search results or claim an address (e.g. the 404 page). */
  noindex?: boolean;
}

const { title = SITE.title, description = SITE.description, noindex = false } = Astro.props;
const OG_IMAGE_ALT = 'The ZAUNITED banner: King Mesmer raises a glowing sword among cheering Zaunites.';
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og-image.jpg', Astro.site).href : undefined;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0918" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.name} />
    {
      /* Share previews need absolute URLs, built from `site` in astro.config.mjs. */
      ogImage && (
        <>
          {canonical && <meta property="og:url" content={canonical} />}
          {canonical && <link rel="canonical" href={canonical} />}
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={OG_IMAGE_ALT} />
        </>
      )
    }
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
