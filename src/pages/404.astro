---
/**
 * "Not found" page. Cloudflare Pages serves this with a real 404 status for
 * unknown addresses (without it, Pages would answer every unknown address
 * with the homepage).
 */
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site.ts';
---

<Base title={`Lost in the mist | ${SITE.name}`} description="This page could not be found." noindex>
  <main id="main" class="lost">
    <div class="container lost-inner">
      <p class="eyebrow">404 · Page not found</p>
      <h1 class="section-title">Lost in the mist</h1>
      <p class="section-lead">This path leads nowhere. Perhaps the Hollowing swallowed it.</p>
      <a class="btn btn--gold" href="/">Return to the Kingdom</a>
    </div>
  </main>
</Base>

<style>
  .lost {
    min-height: 100vh;
    display: grid;
    place-items: center;
    background:
      radial-gradient(60% 50% at 50% 40%, rgba(91, 33, 182, 0.3), transparent 70%),
      var(--bg);
  }

  .lost-inner {
    display: grid;
    gap: 16px;
    justify-items: center;
    text-align: center;
    padding-block: 64px;
  }
</style>
