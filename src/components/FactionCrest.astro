---
/**
 * Original, lightweight faction heraldry (inline SVG, no images).
 *  ember:       crimson and gold, a flame
 *  stonewright: stone-grey and gold, a hammer over a stone block
 *  moonveil:    midnight blue, silver and violet, a veiled crescent
 */
import type { Crest } from '../lib/realm.ts';

interface Props {
  crest: Crest;
  size?: number;
}

const { crest, size = 64 } = Astro.props;
const SHIELD = 'M32 3 L59 11 V35 C59 52 47 63 32 69 C17 63 5 52 5 35 V11 Z';
---

<svg
  class="crest-svg"
  width={size}
  height={Math.round(size * 1.125)}
  viewBox="0 0 64 72"
  aria-hidden="true"
  focusable="false"
>
  {
    crest === 'ember' && (
      <>
        <path d={SHIELD} fill="#7a1529" stroke="#f0c86a" stroke-width="3" />
        <path d="M32 5 L57 12.5 V35 C57 50 46 60.5 32 66.5 Z" fill="#a51d36" />
        <path
          d="M32 17 C37 26 44 31 42.5 43 C41.5 51 37 56 32 56 C26 56 21.5 51 21.5 44.5 C21.5 37 27 33.5 28 27 C30 32 33 33 34 30 C35 26.5 33.5 21.5 32 17 Z"
          fill="#f0c86a"
        />
        <path d="M32 33 C35 38 37.5 41 36.5 46.5 C36 50.5 34 53 32 53 C29.5 53 27.5 50.5 27.5 47.5 C27.5 43 31 41 32 33 Z" fill="#ff8a3d" />
      </>
    )
  }
  {
    crest === 'stonewright' && (
      <>
        <path d={SHIELD} fill="#4b4b57" stroke="#f0c86a" stroke-width="3" />
        <path d="M32 5 L57 12.5 V35 C57 50 46 60.5 32 66.5 Z" fill="#5c5c69" />
        <rect x="17" y="40" width="30" height="13" rx="1.5" fill="#a7a7b3" />
        <path d="M17 46.5 H47 M28 40 V46.5 M38 46.5 V53" stroke="#4b4b57" stroke-width="1.6" />
        <rect x="30" y="16" width="4.5" height="27" rx="1.5" fill="#c9952f" transform="rotate(-35 32 30)" />
        <rect x="21" y="14" width="20" height="9" rx="2" fill="#f0c86a" transform="rotate(-35 32 30)" />
      </>
    )
  }
  {
    crest === 'moonveil' && (
      <>
        <path d={SHIELD} fill="#141a3d" stroke="#c9cdd8" stroke-width="3" />
        <path d="M32 5 L57 12.5 V35 C57 50 46 60.5 32 66.5 Z" fill="#1b2350" />
        <path d="M37 18 A17 17 0 1 0 37 52 A13 13 0 1 1 37 18 Z" fill="#dfe3ec" />
        <path d="M14 30 C22 24 42 24 50 30 L48 34 C40 29 24 29 16 34 Z" fill="#8b5cf6" opacity="0.85" />
        <path d="M16 34 C24 29 40 29 48 34 L46 44 C39 39 25 39 18 44 Z" fill="#8b5cf6" opacity="0.35" />
        <circle cx="45" cy="20" r="1.6" fill="#dfe3ec" />
        <circle cx="49" cy="46" r="1.2" fill="#c4b5fd" />
      </>
    )
  }
</svg>
