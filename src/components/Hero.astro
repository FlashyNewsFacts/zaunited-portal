---
/**
 * Hero: the official ZAUNITED banner (src/assets/brand/zaunited-banner.png).
 * The artwork is only cropped and resized, never altered:
 *  - phones and tablets in portrait: centre 3:2 crop (Mesmer, title, laurels, motto)
 *  - wider screens: the whole banner, uncropped
 * The banner already shows the title and motto, so the text versions are kept
 * for screen readers and search engines but are not shown twice.
 */
import { getImage } from 'astro:assets';
import banner from '../assets/brand/zaunited-banner.png';
import { SITE } from '../lib/site.ts';

const WIDE_MEDIA = '(min-width: 900px)';
const MOBILE_RATIO = 3 / 2;
const MOBILE_WIDTHS = [640, 960, Math.round(banner.height * MOBILE_RATIO)];
const WIDE_WIDTHS = [1200, 1600, banner.width];
const QUALITY = { avif: 55, webp: 78, jpeg: 80 } as const;

type Format = keyof typeof QUALITY;

async function srcset(widths: number[], format: Format, ratio?: number): Promise<string> {
  const images = await Promise.all(
    widths.map((width) =>
      getImage({
        src: banner,
        width,
        ...(ratio ? { height: Math.round(width / ratio), fit: 'cover' as const, position: 'center' } : {}),
        format,
        quality: QUALITY[format],
      }),
    ),
  );
  return images.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
}

const wideAvif = await srcset(WIDE_WIDTHS, 'avif');
const wideWebp = await srcset(WIDE_WIDTHS, 'webp');
const mobileAvif = await srcset(MOBILE_WIDTHS, 'avif', MOBILE_RATIO);
const mobileWebp = await srcset(MOBILE_WIDTHS, 'webp', MOBILE_RATIO);
const fallback = await getImage({
  src: banner,
  width: 960,
  height: 640,
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
  quality: QUALITY.jpeg,
});

const alt =
  'ZAUNITED: The Kingdom of Zaun. From nothing, we shall rise. King Mesmer, crowned and in a red cloak, ' +
  'raises a glowing sword among cheering Zaunites beneath a full moon and a castle on a hill, while the ' +
  'glowing purple eyes of the Hollowing loom in the sky.';
---

<header class="hero">
  <nav class="topbar container" aria-label="Main">
    <a class="crest" href="/">
      <img src="/crest-96.webp" alt="" width="32" height="32" />
      <span>Zaunited</span>
    </a>
    <ul class="nav-links">
      <li><a href="#population">Population</a></li>
      <li><a href="#milestones">Milestones</a></li>
      <li><a href="#hollowing">The Hollowing</a></li>
      <li><a href="#watch">Watch</a></li>
    </ul>
    <a class="btn btn--ghost topbar-join" href="#join">Join</a>
  </nav>

  <div class="hero-banner">
    <picture>
      <source media={WIDE_MEDIA} type="image/avif" srcset={wideAvif} sizes="(min-width: 2172px) 2172px, 100vw" />
      <source media={WIDE_MEDIA} type="image/webp" srcset={wideWebp} sizes="(min-width: 2172px) 2172px, 100vw" />
      <source type="image/avif" srcset={mobileAvif} sizes="100vw" />
      <source type="image/webp" srcset={mobileWebp} sizes="100vw" />
      <img
        src={fallback.src}
        width="960"
        height="640"
        alt={alt}
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>

  <div class="hero-copy container">
    <div class="visually-hidden">
      <p>The Kingdom of Zaun</p>
      <h1>Zaunited</h1>
      <p>{SITE.motto}</p>
    </div>
    <p class="hero-lead">
      A fallen king. A ruined kingdom. A darkness drawing near. King Mesmer must rebuild Zaun before{' '}
      <strong>the Hollowing</strong> arrives, and every new Zaunite helps the kingdom rise.
    </p>
    <div class="hero-actions">
      <a class="btn btn--gold" href="#join">Join the realm</a>
      <a class="btn btn--ghost" href="#watch">Watch the story</a>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(90% 70% at 70% 20%, rgba(107, 69, 176, 0.35), transparent 70%),
      linear-gradient(180deg, #0e0a24 0%, #1a1240 55%, #0b0918 100%);
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: max(16px, env(safe-area-inset-top));
    padding-bottom: 12px;
  }

  .crest {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text);
  }

  .crest img {
    border-radius: 8px;
    box-shadow: 0 0 0 1px var(--border);
  }

  .nav-links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 28px;
  }

  .nav-links a {
    color: var(--text-muted);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .nav-links a:hover {
    color: var(--gold);
  }

  .topbar-join {
    min-height: 44px;
    padding: 8px 18px;
    font-size: 0.8rem;
  }

  .hero-banner {
    width: 100%;
    max-width: 2172px;
    margin-inline: auto;
    background: var(--bg-deep);
    border-block: 1px solid var(--border);
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.9);
  }

  .hero-banner img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .hero-copy {
    display: grid;
    gap: 14px;
    justify-items: center;
    text-align: center;
    padding-block: clamp(24px, 5vw, 40px) clamp(40px, 7vw, 64px);
  }

  .hero-lead {
    max-width: 34rem;
    color: var(--text-muted);
  }

  .hero-lead strong {
    color: var(--crimson-text);
    font-weight: 600;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 4px;
  }

  @media (min-width: 900px) {
    .nav-links {
      display: flex;
    }

    .hero-banner img {
      aspect-ratio: 2172 / 724;
    }

    @media (min-width: 2172px) {
      .hero-banner {
        border-inline: 1px solid var(--border);
      }
    }
  }
</style>
