---
/** Simple, original platform glyphs (decorative; the visible label names the platform). */
import type { PlatformId } from '../lib/kingdom.ts';

interface Props {
  id: PlatformId;
  size?: number;
}

const { id, size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  class="platform-icon"
>
  {
    id === 'youtube' && (
      <>
        <rect x="1.5" y="4.5" width="21" height="15" rx="4.5" fill="currentColor" />
        <path d="M10 8.6v6.8l5.8-3.4z" fill="var(--icon-cutout, #120c26)" />
      </>
    )
  }
  {
    id === 'tiktok' && (
      <path
        fill="currentColor"
        d="M13.6 2.5h3.1c.2 1.9 1.5 3.6 3.8 3.9v3.1c-1.5 0-2.8-.4-3.8-1.1v6.4a5.9 5.9 0 1 1-5.9-5.9c.3 0 .6 0 .9.1v3.2a2.8 2.8 0 1 0 1.9 2.6z"
      />
    )
  }
  {
    id === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5.5" fill="none" stroke="currentColor" stroke-width="2.2" />
        <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2.2" />
        <circle cx="17.4" cy="6.6" r="1.4" fill="currentColor" />
      </>
    )
  }
</svg>
